{
  "tagName": "form",
  "attributes": {
    "class": "max-w-md mx-auto p-6 bg-white rounded-lg shadow-md space-y-4 border border-gray-200"
  },
  "children": [
    {
      "tagName": "h2",
      "attributes": {
        "class": "text-lg font-bold text-gray-800 mb-2"
      },
      "textContent": "User Registration (God Spec Form)---"
    },
    {
      "tagName": "div",
      "attributes": {
        "class": "form-group flex flex-col space-y-1"
      },
      "children": [
        {
          "tagName": "label",
          "attributes": {
            "class": "block text-sm font-medium text-gray-700",
            "for": "username"
          },
          "textContent": "Username"
        },
        {
          "tagName": "input",
          "attributes": {
            "type": "text",
            "id": "username",
            "name": "username",
            "placeholder": "Enter username",
            "class": "border border-gray-300 bg-white rounded px-3 py-2 text-gray-800 focus:outline-none focus:ring-2 focus:ring-blue-500"
          }
        }
      ]
    },
    {
      "tagName": "div",
      "attributes": {
        "class": "form-group flex flex-col space-y-1"
      },
      "children": [
        {
          "tagName": "label",
          "attributes": {
            "class": "block text-sm font-medium text-gray-700",
            "for": "email"
          },
          "textContent": "Email Address"
        },
        {
          "tagName": "input",
          "attributes": {
            "type": "email",
            "id": "email",
            "name": "email",
            "placeholder": "name@example.com",
            "class": "border border-gray-300 bg-white rounded px-3 py-2 text-gray-800 focus:outline-none focus:ring-2 focus:ring-blue-500"
          }
        }
      ]
    },
    {
      "tagName": "div",
      "attributes": {
        "class": "form-group flex flex-col space-y-1"
      },
      "children": [
        {
          "tagName": "label",
          "attributes": {
            "class": "block text-sm font-medium text-gray-700",
            "for": "password"
          },
          "textContent": "Password"
        },
        {
          "tagName": "input",
          "attributes": {
            "type": "password",
            "id": "password",
            "name": "password",
            "placeholder": "••••••••",
            "class": "border border-gray-300 bg-white rounded px-3 py-2 text-gray-800 focus:outline-none focus:ring-2 focus:ring-blue-500"
          }
        }
      ]
    },
    {
      "tagName": "div",
      "attributes": {
        "class": "pt-2"
      },
      "children": [
        {
          "tagName": "button",
          "attributes": {
            "type": "submit",
            "class": "w-full bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded transition-colors"
          },
          "textContent": "Submit Form"
        }
      ]
    }
